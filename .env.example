# Supabase Auth / Postgres (do not commit real values).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server/worker only. Use the project's modern `sb_secret_...` key, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
RAMP_API_BASE_URL=https://demo-api.ramp.com
# Enable Client Credentials and these scopes in your Sandbox developer app.
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=
RAMP_SCOPES="bills:read bills:write entities:read vendors:read"
# Optional override; leave blank when using client credentials.
RAMP_ACCESS_TOKEN=
# Buying entities are mapped per team in Supabase, not in this file.
# Supplier vendor ID in the shared Sandbox business.
RAMP_VENDOR_ID=
# Set after creating the webhook subscription; not the client secret.
RAMP_WEBHOOK_SECRET=
# Populated by scripts/setup-ramp-webhook.ts. The worker requires the same env/database.
RAMP_BUSINESS_ID=
RAMP_WEBHOOK_ID=
RAMP_WEBHOOK_SETUP_TOKEN=
RAMP_WEBHOOK_URL=
